# Every per-user value the project needs, grouped by the guide phase that produces it.
# `just setup-env` generates the real, git-ignored .env with these keys.
# Auto-detected keys are filled on first run; the rest stay blank until you reach that phase.
# Never put secrets here or in .env; secrets live in Azure Key Vault.
#
# The justfile loads .env automatically for every `just` command. Committed files reference
# these values via:
#   Terraform   — TF_VAR_* env vars (native)
#   Helm        — --set flags via `just helm-upgrade <env>`
#   dbt         — {{ env_var('...') }} in profiles.yml, via `just dbt <env> build`
#   Bundle CLI  — DATABRICKS_HOST env var, via `just bundle-deploy <env>`
#   CI          — GitHub repo variables (same names, set in Phase 0.6)

# ── Phase 0 — project settings (review after running setup-env.sh) ───────────
TF_VAR_project=dagster    # resource name prefix (rg-{project}-shared, aks-{project}, etc.)
TF_VAR_location=eastus2   # Azure region for all resources

# ── Phase 0 — auto-detected by scripts/setup-env.sh ─────────────────────────
TF_VAR_subscription_id=   # az account show --query id
TF_VAR_tenant_id=         # az account show --query tenantId
TF_VAR_my_ip_cidr=        # your public IP as x.x.x.x/32 (firewalls, AKS authorized ranges)
TF_VAR_github_repo=       # org/repo from git remote (OIDC federated credentials)
TF_VAR_github_oidc_prefix=  # OIDC subject prefix with org/repo IDs (auto-detected via gh api)
TF_VAR_owner=             # git user.name (resource tags)
ARM_SUBSCRIPTION_ID=      # same as TF_VAR_subscription_id (azurerm/azuread providers)
ARM_TENANT_ID=            # same as TF_VAR_tenant_id

# ── Phase 0.5 — terraform bootstrap outputs ──────────────────────────────────
AZURE_CLIENT_ID=          # Entra app client ID for GitHub OIDC (terraform output -raw client_id)
TF_BACKEND_STORAGE_ACCOUNT=  # e.g. stdagstertfxxxx (terraform output -raw storage_account_name)
TF_BACKEND_RESOURCE_GROUP=   # rg-dagster-tfstate (terraform output -raw resource_group_name)

# ── Phase 1 — shared infra outputs (scripts/setup-env.sh collect-tf shared) ──
ACR_NAME=                 # e.g. acrdagsterxxxx (terraform output)
ACR_LOGIN_SERVER=         # e.g. acrdagsterxxxx.azurecr.io (terraform output)
PG_FQDN=                 # e.g. pg-dagster.postgres.database.azure.com (terraform output)
KV_NAME=                  # e.g. kv-dagster-xxxx (terraform output)
STORAGE_ACCOUNT_NAME=     # e.g. stdagsterxxxx (terraform output)
AKS_EGRESS_IP=            # AKS outbound public IP (terraform output, used for firewalls)

# ── Phase 2 — stage environment ──────────────────────────────────────────────
TF_VAR_metastore_id=      # Unity Catalog metastore ID (manual — guide step 2.3)
DBX_STAGE_HOST=           # Databricks workspace URL (terraform output from infra/env stage)
DBX_STAGE_WORKSPACE_ID=   # workspace ID (manual — guide step 2.2, or terraform output)
DBX_STAGE_SP_CLIENT_ID=   # service principal client ID (terraform output — also in Key Vault)
DBX_STAGE_WAREHOUSE_HTTP_PATH=  # SQL warehouse HTTP path (terraform output)
DAGSTER_STAGE_IDENTITY_CLIENT_ID=  # managed identity client ID for workload identity (terraform output)

# ── Phase 4 — prod environment ───────────────────────────────────────────────
DBX_PROD_HOST=            # same shape as stage; terraform output from infra/env prod
DBX_PROD_WORKSPACE_ID=    # manual — guide step 4.2, or terraform output
DBX_PROD_SP_CLIENT_ID=    # terraform output
DBX_PROD_WAREHOUSE_HTTP_PATH=  # terraform output
DAGSTER_PROD_IDENTITY_CLIENT_ID=  # terraform output
