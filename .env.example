# Documentation only. scripts/setup-env.sh generates the real, git-ignored .env with these keys.
# Never put secrets here or in .env; secrets live in Azure Key Vault.

# Detected by scripts/setup-env.sh
TF_VAR_subscription_id=   # from `az account show`
TF_VAR_tenant_id=         # from `az account show`
TF_VAR_my_ip_cidr=        # your public IP as x.x.x.x/32 (firewalls, authorized ranges)
TF_VAR_github_repo=       # org/repo, from the git remote (OIDC federated credentials)
TF_VAR_owner=             # from git user.name; the `owner` resource tag
ARM_SUBSCRIPTION_ID=      # same as TF_VAR_subscription_id
ARM_TENANT_ID=            # same as TF_VAR_tenant_id

# Added later with `scripts/setup-env.sh set KEY VALUE` as the runbook produces them
# TF_VAR_metastore_id=    # runbook 2.3
